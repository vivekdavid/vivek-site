  <script>
    // State management
    const totalSections =11;
    const container = document.getElementById('scroll-container');
    const navContainer = document.getElementById('section-nav');

    // Generate right-side section dots
    for (let i = 1; i <= totalSections; i++) {
      const dot = document.createElement('button');
      dot.className = 'nav-dot' + (i === 1 ? ' active' : '');
      dot.setAttribute('aria-label', `Go to section ${i}`);
      dot.onclick = () => {
        document.getElementById(`sec-${i}`).scrollIntoView({ behavior: 'smooth' });
      };
      dot.id = `nav-dot-${i}`;
      navContainer.appendChild(dot);
    }

    // Scroll to next helper
    function scrollToNext(currentSec) {
      const nextSec = currentSec + 1;
      if (nextSec <= totalSections) {
        document.getElementById(`sec-${nextSec}`).scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Scroll to top
    function scrollToTop() {
      document.getElementById('sec-1').scrollIntoView({ behavior: 'smooth' });
    }

    // Intersection Observer for animations and dots active state
    const observerOptions = {
      root: container,
      threshold: 0.5
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          const secNum = parseInt(id.replace('sec-', ''));

          // Update navigation dots
          for (let i = 1; i <= totalSections; i++) {
            const dot = document.getElementById(`nav-dot-${i}`);
            if (i === secNum) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          }

          // Trigger internal element reveals
          const reveals = entry.target.querySelectorAll('.reveal-element');
          reveals.forEach(el => el.classList.add('active'));
        }
      });
    }, observerOptions);

    // Observe all sections
    document.querySelectorAll('.snap-section').forEach(sec => {
      sectionObserver.observe(sec);
    });
 
// Force one-section-at-a-time with arrow keys / PageUp / PageDown
document.addEventListener('keydown', (e) => {
  const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '];
  if (!keys.includes(e.key)) return;

  // Don't steal keys when user is typing in an input/textarea
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

  e.preventDefault();

  // Figure out which section is currently most visible
  let current = 1;
  document.querySelectorAll('.snap-section').forEach((sec, i) => {
    const rect = sec.getBoundingClientRect();
    if (rect.top <= window.innerHeight / 2 && rect.bottom >= window.innerHeight / 2) {
      current = i + 1;
    }
  });

  let target = current;

  if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
    target = Math.min(current + 1, totalSections);
  } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
    target = Math.max(current - 1, 1);
  }

  if (target !== current) {
    document.getElementById(`sec-${target}`).scrollIntoView({ behavior: 'smooth' });
  }
});

  </script>
