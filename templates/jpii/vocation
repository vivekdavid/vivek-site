      max-width: 42rem;
      margin: 0 auto;
    }

    .epilogue-icon {
      color: var(--papal-gold);
      font-size: 1.875rem;
      margin-bottom: 1.5rem;
    }

    .epilogue-title {
      font-family: var(--font-serif);
      font-size: 1.875rem;
      color: var(--papal-cream);
      margin-bottom: 1.5rem;
    }

    @media (min-width: 768px) {
      .epilogue-title {
        font-size: 3rem;
      }
    }

    .epilogue-text {
      font-family: var(--font-sans);
      font-size: 0.875rem;
      color: #9ca3af;
      margin-bottom: 2rem;
      max-width: 28rem;
      margin-left: auto;
      margin-right: auto;
    }

    .return-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--papal-gold);
      color: var(--papal-gold);
      padding: 0.75rem 1.5rem;
      border-radius: 9999px;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      font-weight: 600;
      transition: background-color 0.2s, color 0.2s;
    }

    .return-btn:hover {
      background-color: var(--papal-gold);
      color: var(--papal-dark);
    }
